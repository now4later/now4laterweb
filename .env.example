# --- NOW4LATERWEB — Phase 1 environment variables ---
# Copy this file to .env.local for local development.
# In Vercel: Project Settings -> Environment Variables (do NOT commit real values).
# These are separate from and unrelated to any R&J Productions / music site credentials.

# Resend (https://resend.com) API key used ONLY to send NOW4LATERWEB inquiry emails.
RESEND_API_KEY=

# The inbox that should receive new inquiries (your NOW4LATERWEB business email).
INQUIRY_TO_EMAIL=

# The "from" address Resend sends as. Must be on a domain you've verified with Resend.
# (You can use Resend's shared onboarding domain for initial testing.)
INQUIRY_FROM_EMAIL=

# --- Phase 2: database + authentication ---

# Postgres connection string. If using Vercel Postgres, Vercel injects this
# automatically when you attach a Postgres database to the project; for local
# dev, create one at https://vercel.com/storage/postgres (or run Postgres
# locally) and paste its connection string here.
DATABASE_URL=

# Random secret NextAuth uses to sign session tokens. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# The full URL of this deployment. http://localhost:3000 for local dev;
# your real domain (e.g. https://now4laterweb.com) in production.
NEXTAUTH_URL=http://localhost:3000

# Used only once, locally, to run `npm run create-admin` and create your own
# admin login. Not read by the deployed app itself — safe to leave unset in
# Vercel's environment variables.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- Phase 4: file uploads ---

# Vercel Blob read/write token. In Vercel: Storage -> Create Database ->
# Blob -> connect it to this project, and Vercel adds this automatically.
# For local dev, copy the same token value from the Blob store's settings
# page into .env.local.
BLOB_READ_WRITE_TOKEN=

# --- Public site config (fixes the placeholder email/social links) ---
# These are safe to expose in the browser (NEXT_PUBLIC_) since they're just
# your public contact info. Leave any of these unset and that
# button/link/icon simply won't render, rather than pointing somewhere fake.

# Your real NOW4LATERWEB business email, shown in the CTA button and footer.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional — only add the ones you actually have.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
