// NOW4LATERWEB — database schema
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum PaymentOption {
  FULL
  SPLIT
  PAYMENT_PLAN
}

enum AgreementStatus {
  PENDING
  SIGNED
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  REVIEW
  LAUNCHED
}

enum PaymentType {
  DEPOSIT
  BALANCE
  FULL
  MAINTENANCE
  UPDATE
}

enum PaymentStatus {
  PENDING
  PAID
}

enum UpdateRequestStatus {
  OPEN
  IN_PROGRESS
  DONE
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          Role     @default(CLIENT)
  name          String?
  businessName  String?
  createdAt     DateTime @default(now())

  agreements     Agreement[]
  updateRequests UpdateRequest[]
  files          ProjectFile[]
}

model Agreement {
  id            String          @id @default(cuid())
  clientId      String
  client        User            @relation(fields: [clientId], references: [id])
  version       Int             @default(1)
  content       String          @db.Text
  paymentOption PaymentOption?
  totalAmount   Int             @default(100000)
  status        AgreementStatus @default(PENDING)
  projectStatus ProjectStatus   @default(NOT_STARTED)
  createdAt     DateTime        @default(now())

  signature Signature?
  payments  Payment[]
}

model Signature {
  id               String    @id @default(cuid())
  agreementId      String    @unique
  agreement        Agreement @relation(fields: [agreementId], references: [id])
  signerName       String
  signerEmail      String
  agreementVersion Int
  agreementHash    String
  ipAddress        String
  userAgent        String
  signedAt         DateTime  @default(now())
}

model Payment {
  id          String        @id @default(cuid())
  agreementId String
  agreement   Agreement     @relation(fields: [agreementId], references: [id])
  amount      Int
  type        PaymentType
  status      PaymentStatus @default(PENDING)
  dueDate     DateTime?
  paidAt      DateTime?
  notes       String?
}

model UpdateRequest {
  id          String              @id @default(cuid())
  clientId    String
  client      User                @relation(fields: [clientId], references: [id])
  category    String
  description String              @db.Text
  status      UpdateRequestStatus @default(OPEN)
  createdAt   DateTime            @default(now())

  files ProjectFile[]
}

model ProjectFile {
  id              String         @id @default(cuid())
  clientId        String
  client          User           @relation(fields: [clientId], references: [id])
  updateRequestId String?
  updateRequest   UpdateRequest? @relation(fields: [updateRequestId], references: [id])
  url             String
  filename        String
  createdAt       DateTime       @default(now())
}
